# Supabase — anon key is public; service role stays on the server only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Native CMS — Railway Postgres (prefer a URL that can create schema `cms`)
# Never expose this to the browser / NEXT_PUBLIC_*
CMS_DATABASE_URL=postgresql://user:pass@host:5432/railway

# Admin auth (required before deploying /admin)
# Generate secret: openssl rand -base64 48
CMS_AUTH_SECRET=replace-with-long-random-secret-at-least-32-chars
CMS_ADMIN_EMAIL=owner@mangcrinkle.co.nz
CMS_ADMIN_NAME=Mang Crinkle Admin
# Generate hash: npm run cms:hash-password -- "your-password"
CMS_ADMIN_PASSWORD_HASH=

# Order emails (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
ORDER_EMAIL_TO=mangcrinkle@gmail.com

# Owner notification (new orders land here)
ORDER_EMAIL_FROM=Mang Crinkle <orders@mangcrinkle.co.nz>

# Customer confirmation (no-reply; replies go to ORDER_EMAIL_REPLY_TO)
ORDER_EMAIL_FROM_CUSTOMER=Mang Crinkle <noreply@mangcrinkle.co.nz>
ORDER_EMAIL_REPLY_TO=mangcrinkle@gmail.com

# Testing before domain is verified in Resend — use for both FROM vars:
# ORDER_EMAIL_FROM=Mang Crinkle <onboarding@resend.dev>
# ORDER_EMAIL_FROM_CUSTOMER=Mang Crinkle <onboarding@resend.dev>
