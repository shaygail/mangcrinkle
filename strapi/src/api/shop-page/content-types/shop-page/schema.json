{
  "kind": "singleType",
  "collectionName": "shop_pages",
  "info": {
    "singularName": "shop-page",
    "pluralName": "shop-pages",
    "displayName": "Shop Page",
    "description": "Shop page header and section descriptions"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "The Crinkle Shop"
    },
    "subtitle": {
      "type": "string",
      "default": "Filipino Sweet Magic"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.shop-section"
    },
    "howToOrderEyebrow": {
      "type": "string",
      "default": "Simple Steps"
    },
    "howToOrderTitle": {
      "type": "string",
      "default": "How To Order"
    },
    "howToOrderBody": {
      "type": "text",
      "default": "Fresh crinkles, your way — ready in minutes."
    },
    "howToOrderLinkText": {
      "type": "string",
      "default": "See pickup steps →"
    },
    "howToOrderLinkHref": {
      "type": "string",
      "default": "/#order"
    }
  }
}
